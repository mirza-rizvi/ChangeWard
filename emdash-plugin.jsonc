{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "changeward",
	// PLACEHOLDER: replace with your real Atmosphere DID or handle before publishing.
	"publisher": "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa",

	"license": "MIT",
	"author": { "name": "Rizvi", "url": "https://github.com/mirza-rizvi" },
	// Private vulnerability reports go through GitHub security advisories.
	"security": { "url": "https://github.com/mirza-rizvi/ChangeWard/security/advisories/new" },
	"description": "See who changed what on your EmDash website, watch your most important pages, and stop risky changes before they go live.",
	"repo": "https://github.com/mirza-rizvi/ChangeWard",

	// Trust contract. Every entry is justified in docs/CAPABILITIES.md.
	// Adding a capability in a later release requires administrators to approve it again.
	"capabilities": [
		"content:read",
		"hooks.content-policy:register",
		"redirects:read",
		"media:read",
		"email:send"
	],
	// No outbound network access at all.
	"allowedHosts": [],

	// Every index backs a query in src/admin or src/cron (see docs/DATA_MODEL.md).
	"storage": {
		"events": {
			"indexes": [
				"createdAt",
				["originSource", "createdAt"],
				["category", "createdAt"],
				["action", "createdAt"],
				["severity", "createdAt"],
				["protectedResource", "createdAt"],
				["resourceKey", "createdAt"],
				["incidentId", "createdAt"]
			]
		},
		"incidents": {
			"indexes": ["updatedAt", ["status", "updatedAt"]]
		},
		"resources": {
			"indexes": ["lastSeenAt", ["isProtected", "protectedAt"]]
		}
	},

	"admin": {
		"pages": [
			{ "path": "/overview", "label": "ChangeWard", "icon": "shield" },
			{ "path": "/activity", "label": "Activity", "icon": "list" },
			{ "path": "/incidents", "label": "Incidents", "icon": "alert" },
			{ "path": "/protected", "label": "Protected", "icon": "lock" },
			{ "path": "/policies", "label": "Policies", "icon": "check" },
			{ "path": "/settings", "label": "Settings", "icon": "settings" }
		],
		"widgets": [
			{ "id": "status", "title": "ChangeWard status", "size": "half" },
			{ "id": "incidents", "title": "Open incidents", "size": "half" }
		],
		"editorPanels": [
			{ "id": "history", "title": "ChangeWard", "route": "editor/panel" }
		]
	}
}
