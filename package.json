{
	"name": "changeward",
	"version": "0.1.0",
	"description": "Know what changed, who changed it, and how it happened. Change monitoring and publishing protection for EmDash.",
	"license": "MIT",
	"author": "Rizvi",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"change monitoring",
		"audit log",
		"activity log",
		"MCP",
		"content integrity",
		"publishing policies",
		"protected content"
	],
	"homepage": "https://github.com/mirza-rizvi/ChangeWard#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mirza-rizvi/ChangeWard.git"
	},
	"bugs": {
		"url": "https://github.com/mirza-rizvi/ChangeWard/issues"
	},
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.0.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "1.0.1",
		"@emdash-cms/plugin-cli": "0.13.1",
		"@emdash-cms/plugin-test": "0.2.6",
		"emdash": "1.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	}
}
